[Unit]
Description=UPA Patient Flow Simulator - Protocolo de Manchester
Documentation=file:///opt/upa-simulator/SIMULATOR_README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/upa-simulator

ExecStart=/opt/upa-simulator/venv/bin/python /opt/upa-simulator/upa_simulator.py

Restart=always
RestartSec=10

TimeoutStartSec=30
TimeoutStopSec=30

StandardOutput=append:/var/log/upa-simulator/upa-simulator.log
StandardError=append:/var/log/upa-simulator/upa-simulator-error.log

MemoryLimit=512M
CPUQuota=50%

Environment="PYTHONUNBUFFERED=1"

# Segurança (opcional)
# NoNewPrivileges=true
# PrivateTmp=true

[Install]
WantedBy=multi-user.target