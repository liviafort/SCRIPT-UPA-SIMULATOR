  "how_to_use": {
    "step_1": "Escolha o cenário que deseja simular",
    "step_2": "Copie a seção 'upas' e 'simulation' do cenário escolhido",
    "step_3": "Cole no arquivo config.json principal, substituindo as seções correspondentes",
    "step_4": "Ajuste os valores conforme necessário",
    "step_5": "Reinicie o simulador"
  },

  "tips": {
    "real_time_factor": "Use valores maiores que 1.0 para acelerar a simulação durante testes",
    "patient_flow_mode": "Use 'per_hour' para configuração mais intuitiva no dia a dia",
    "classificacao_distribution": "Baseie-se em dados reais da UPA para distribuição realista",
    "monitoring": "Monitore os logs para identificar gargalos e ajustar a configuração"
  }
