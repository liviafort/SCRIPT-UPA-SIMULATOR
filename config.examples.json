        "UPA Dinamérica": {
          "enabled": true,
          "patient_flow": {
            "mode": "per_hour",
            "rate": 15
          },
          "classificacao_distribution": {
            "VERMELHO": 0.05,
            "AMARELO": 0.25,
            "VERDE": 0.50,
            "AZUL": 0.20
          }
        },
        "UPA Alto Branco": {
          "enabled": true,
          "patient_flow": {
            "mode": "per_hour",
            "rate": 18
          },
          "classificacao_distribution": {
            "VERMELHO": 0.08,
            "AMARELO": 0.30,
            "VERDE": 0.45,
            "AZUL": 0.17
          }
        }
      },
      "simulation": {
        "real_time_factor": 1.0
      }
    },

